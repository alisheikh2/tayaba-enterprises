# Environment Variables Example for Tayaba Enterprises Website

# Admin Panel Credentials
ADMIN_USER=admin
ADMIN_PASSWORD=tayaba2003

# Email Notification Service (Formspree or Resend API)
RESEND_API_KEY=re_123456789_placeholder
CONTACT_RECIPIENT_EMAIL=tayaba_enterprises@yahoo.com

# MongoDB Atlas (Optional persistent backend database)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/tayaba_db

# Cloudinary (Optional image upload service for client logos)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
